OPENAI_API_KEY=<openai-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>
GOOGLE_API_KEY=<google-api-key>
LANGFUSE_SECRET_KEY=<langfuse-secret-key>
LANGFUSE_PUBLIC_KEY=<langfuse-public-key>
LANGFUSE_HOST=http://localhost:3000
MAPBOX_ACCESS_TOKEN=<mapbox-api-key>
# Legacy fallback key, still supported:
MAPBOX_API_TOKEN=<mapbox-api-key>
MAPBOX_STYLE_ID=mapbox/outdoors-v12
MAPBOX_STATIC_TIMEOUT_SECONDS=2.5
MAPBOX_STATIC_SCALE=2
WRI_API_KEY=<wri-api-key>
WRI_BEARER_TOKEN=<wri-bearer-token>
DOMAINS_ALLOWLIST=<domains-allowlist>
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zeno-data-local
STREAMLIT_URL=http://localhost:8501 # URL where the Streamlit app is hosted
COOKIE_SIGNER_SECRET_KEY="secret-cookie-key-123"
NEXTJS_API_KEY=<nextjs-api-key>
DATASET_EMBEDDINGS_DB=<name-of-dataset-embeddings-db>
# Model Configuration
# Available options: sonnet, haiku, gemini, gemini-flash, gpt, phi4, smollm2
MODEL=gemini
SMALL_MODEL=gemini-flash
EOAPI_BASE_URL=https://eoapi.staging.globalnaturewatch.org

# Lite / Telegram
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<telegram-webhook-secret>
LITE_MAX_RESPONSE_WORDS=300
LITE_TELEGRAM_MESSAGE_CHAR_LIMIT=4096
LITE_ENABLE_MODEL_REWRITE=true
LITE_TELEGRAM_ENABLE_CHARTS=true
LITE_TELEGRAM_ENABLE_MAP_BUTTONS=true
LITE_TELEGRAM_ENABLE_MAPS=true
LITE_TELEGRAM_INTERACTION_TTL_SECONDS=3600
LITE_TELEGRAM_INTERACTION_CACHE_SIZE=100000
LITE_CHART_CAPTION_MAX_CHARS=1024
LITE_MAP_CAPTION_MAX_CHARS=1024
LITE_CHART_RENDER_DPI=180
LITE_CHART_WIDTH_PX=1200
LITE_CHART_HEIGHT_PX=750

# Test Database connection - for development only
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/zeno-data_test
